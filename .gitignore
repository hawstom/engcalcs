# Lock records are runtime state, like log/. The directory and its .htaccess are tracked;
# the records themselves are not.
lpn-locks/*.json

# The browser pass installs playwright-core locally; the Chromium binary lives in the
# user cache, not here. Both are reproducible from dev/browser-pass/package.json.
dev/browser-pass/node_modules/
dev/browser-pass/package-lock.json
