#!/bin/sh
# Refuse a commit on master. Installed by dev/hooks/install.sh; see CLAUDE.md, Git Workflow.
#
# **MASTER IS THE PRODUCTION LINE AND NOBODY WORKS ON IT** (2026-09-12). That rule was written and
# then broken by its own author three times in the hour after writing it, which is this project's
# standing argument in one sentence: a rule a machine enforces is worth roughly ten a human must
# remember.
#
# **A MERGE IS THE EXCEPTION AND IS DETECTED, NOT DECLARED.** During `git merge`, git writes
# .git/MERGE_HEAD before running this hook, so a merge commit is told from a hand-written one
# without anybody passing a flag. That matters because a flag people pass routinely is a flag people
# pass reflexively.
#
# The escape hatch is `git commit --no-verify`, which git provides and this hook cannot take away.
# That is correct: the hook is here to stop drift, not to stop you.

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
[ "$branch" = "master" ] || exit 0
# **A MERGE COMMIT IS NOT WAVED THROUGH ANY MORE; IT IS HANDED TO THE MERGE GATE.** This line used
# to be a bare `exit 0`, and that was right when the only rule was "no hand-written commit on
# master". It became a HOLE on 2026-09-13, when merging itself acquired a rule: a CONFLICTED merge
# never reaches pre-merge-commit at all -- git stops, the human runs `git commit`, and this hook is
# what fires. So the door that most of a busy session's merges actually go through was the one
# exempting them. MERGE_HEAD exists here, which is what pre-merge-commit lacks.
merge_head_file="$(git rev-parse --git-dir)/MERGE_HEAD"
if [ -f "$merge_head_file" ]; then
	root=$(git rev-parse --show-toplevel 2>/dev/null)
	[ -f "$root/dev/branch-policy.json" ] || exit 0
	msg_file="$(git rev-parse --git-dir)/MERGE_MSG"
	php "$root/dev/scripts/branch_gate.php" "$(head -n1 "$merge_head_file")" \
		"$(head -n1 "$msg_file" 2>/dev/null)" || exit 1
	exit 0
fi

cat >&2 <<'MSG'

  REFUSED: this is a commit on master, and master is the production line.

  Every change starts on a branch and reaches master by a merge. Move this work:

      git stash
      git checkout -b <name>
      git stash pop

  Naming: a short descriptive slug (profile-blank-on-arm), or <task-id>-<slug> when a
  roadmap task exists (627-blank-map-autosave). No date prefix -- git already knows the
  age, and dev/scripts/branch_hygiene_check.php prints it.

  A merge commit is allowed here and needs nothing from you.
  Genuinely need to bypass?  git commit --no-verify

MSG
exit 1
