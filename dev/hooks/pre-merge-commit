#!/bin/sh
# Refuse a merge into master that Tom has not cleared. Installed by dev/hooks/install.sh.
#
# **GREEN IS NOT DONE, AND THAT IS THE WHOLE OF WHY THIS EXISTS.** On 2026-09-13 six capability
# merges landed on master in one session, every one with check_all.sh passing and the pre-push stamp
# in place. Both existing hooks worked perfectly and neither had anything to say, because neither
# asks the question that mattered: is the FEATURE finished? `projection` went in carrying 183 of
# 5,346 projections while "We won't deploy with UTM only" was a standing instruction that appeared
# nowhere in this repository.
#
# **THERE IS NO MERGE_HEAD HERE, AND THE FIRST DRAFT OF THIS HOOK DIED ON THAT.** It read
# .git/MERGE_HEAD, which git has NOT written when pre-merge-commit runs on a clean merge -- so the
# hook exited 0 on every real merge and the guard was decorative. It failed OPEN and SILENTLY, the
# exact pair dev/hooks/install.sh already warns about, and the selftest did not catch it because it
# drove branch_gate.php directly and never ran a merge. What git DOES give us is GIT_REFLOG_ACTION,
# which reads "merge <what was named on the command line>".
#
# **THE CONFLICTED MERGE TAKES A DIFFERENT DOOR ENTIRELY**, which was the other half of the hole:
# git stops, the human runs `git commit`, and that fires pre-commit -- which exempted merge commits
# by construction. pre-commit carries this same gate for that path now. Two doors, one decision,
# and dev/scripts/branch_policy_selftest.php section 9 drives BOTH with real merges.
#
# Bypass with `git merge --no-verify`. That is correct: the hook stops drift, not Tom.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "master" ] || exit 0
[ -f "$root/dev/branch-policy.json" ] || exit 0

# WHAT IS BEING MERGED, from the reflog action git sets for us: "merge projection".
named=${GIT_REFLOG_ACTION#merge }
[ "$named" = "$GIT_REFLOG_ACTION" ] && exit 0   # not a merge action: nothing to judge
merge_sha=$(git rev-parse --verify "$named" 2>/dev/null) || exit 0

# **THE SUBJECT COMES FROM MERGE_MSG, WHICH IS THE MESSAGE ACTUALLY BEING WRITTEN.** Passing
# "merge $named" instead was a real flaw and it bit on the first live use: a merge deliberately
# subjected `hotfix:` was refused by the freeze, because the hook had thrown that word away before
# the gate could read it. MERGE_MSG exists here even though MERGE_HEAD does not.
msg_file="$(git rev-parse --git-dir)/MERGE_MSG"
subject=$(head -n1 "$msg_file" 2>/dev/null)
[ -n "$subject" ] || subject="merge $named"

php "$root/dev/scripts/branch_gate.php" "$merge_sha" "$subject" || exit 1
exit 0
