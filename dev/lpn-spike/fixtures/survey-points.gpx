<?xml version="1.0" encoding="UTF-8"?>
<!-- A made-up handheld GPS waypoint export, for testing the import (ROADMAP Task 592).
     WP-4 carries no latitude at all, so the import reports it and creates nothing for it.
     The one trkpt below is a breadcrumb rather than a surveyed place, and the report says so.
     A GPX elevation is in meters by definition of the format. -->
<gpx version="1.1" creator="EngCalcs test fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <wpt lat="33.415300" lon="-111.831400"><name>WP-1</name><ele>379.0</ele></wpt>
  <wpt lat="33.415910" lon="-111.831400"><name>WP-2</name><ele>379.5</ele></wpt>
  <wpt lat="33.416520" lon="-111.830780"><name>WP-3</name><ele>380.4</ele></wpt>
  <wpt lon="-111.829950"><name>WP-4</name><ele>381.2</ele></wpt>
  <wpt lat="33.415300" lon="-111.829950"><name>WP-5</name></wpt>
  <trk><name>Walk back to the truck</name><trkseg>
    <trkpt lat="33.415100" lon="-111.830100"><ele>378.6</ele></trkpt>
  </trkseg></trk>
</gpx>
