    "glossary_terms_by_prefix": {
        "mi": [
            {
                "term": "flow",
                "symbol": "Q",
                "context": "Volumetric flow rate. Appears in every calculator. Use the hydraulic\/civil engineering term for discharge volume per unit time, not a general word for 'water flowing'.",
                "translation_notes": "Spanish has two common terms: 'caudal' (Spain, South America) and 'gasto' (Mexico). Lead with 'caudal'. Portuguese: 'vazão' (Brazil) or 'caudal' (Portugal) — lead with 'vazão'.",
                "preferred_translation": "protok"
            },
            {
                "term": "velocity",
                "symbol": "v",
                "context": "Flow velocity (speed of water). Appears in all calculators.",
                "translation_notes": "Most languages use a direct cognate of 'velocity'. Do not use a word meaning 'speed' in a general sense if a more precise hydraulic term exists.",
                "preferred_translation": "brzina"
            },
            {
                "term": "hydraulic radius",
                "symbol": "R_h",
                "context": "Cross-sectional flow area divided by wetted perimeter. Appears in Manning calculators.",
                "translation_notes": "Standard term in hydraulic engineering — most languages use a direct translation. Do not confuse with 'pipe radius'.",
                "preferred_translation": "hidraulički polumjer"
            },
            {
                "term": "wetted perimeter",
                "symbol": "P_w",
                "context": "Length of the channel or pipe boundary in contact with flowing water. Appears in Manning calculators.",
                "translation_notes": "Use the standard hydraulic engineering phrase. 'Wetted' here means 'in contact with water', not 'soaked'.",
                "preferred_translation": "močeni opseg"
            },
            {
                "term": "Manning roughness",
                "symbol": "n",
                "context": "Manning's n — empirical roughness coefficient used in the Manning formula for open-channel and pipe flow.",
                "translation_notes": "Always include 'Manning' as a proper noun. The coefficient itself (n) needs no translation — only the label does. Do not translate as generic 'roughness coefficient' without 'Manning'.",
                "preferred_translation": "Manningov koeficijent hrapavosti"
            },
            {
                "term": "slope",
                "symbol": "S",
                "context": "Dimensionless ratio of vertical drop to horizontal distance (rise\/run). Used as channel slope (S_0) and friction slope in Manning and Darcy-Weisbach calculators.",
                "translation_notes": "In open-channel hydraulics, 'slope' is the bed gradient — not the angle. Use the civil engineering term for gradient\/grade, not a geographic or topographic term.",
                "preferred_translation": "nagib"
            }
        ],
        "odt": [
            {
                "term": "orifice",
                "symbol": "",
                "context": "A submerged or free-flowing opening through which water discharges under head. Appears in Orifice Flow and Orifice Drain Time calculators.",
                "translation_notes": "In irrigation contexts, often the opening of a headgate or pipe turnout. Use the hydraulic engineering term, not a general word for 'hole' or 'opening'.",
                "preferred_translation": "otvor"
            },
            {
                "term": "discharge coefficient",
                "symbol": "C_d",
                "context": "Coefficient correcting theoretical orifice or weir flow for real-world contraction and friction effects. Appears in Orifice and Weir calculators.",
                "translation_notes": "The 'discharge' here refers to flow rate, not the verb. Use the hydraulic engineering compound term.",
                "preferred_translation": "koeficijent istjecanja"
            },
            {
                "term": "headwater elevation",
                "symbol": "",
                "context": "Water surface elevation on the upstream side of a weir or orifice. Appears in Weir Flow and Orifice calculators.",
                "translation_notes": "'Headwater' is an upstream water surface — do not confuse with 'head' (energy) or 'source' (origin of a stream). Use the hydraulic structure term.",
                "preferred_translation": "razina uzvodne vode"
            },
            {
                "term": "tailwater elevation",
                "symbol": "",
                "context": "Water surface elevation on the downstream side of a weir or orifice. Appears in Orifice Flow calculator. When tailwater is above the invert, the orifice is submerged.",
                "translation_notes": "Use the hydraulic structure term for downstream water level. Pair consistently with 'headwater elevation'.",
                "preferred_translation": "razina nizvodne vode"
            }
        ],
