# Redirect old /lib/ asset paths to current locations.
# These were cached by browsers before the CSS/JS directories were reorganized.
Redirect 301 /engcalcs/lib/engcalcs.css /engcalcs/css/engcalcs.css
Redirect 301 /engcalcs/lib/Cookies.lib.js /engcalcs/js/Cookies.lib.js
Redirect 301 /engcalcs/lib/Calculators.lib.js /engcalcs/js/Calculators.lib.js

# Block dotfiles and non-web source files.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|txt)$">
    Require all denied
</FilesMatch>

# Block the .git directory. FilesMatch above matches FILENAMES only, so it never
# covered this: .git's contents are named config, HEAD, index, objects/ -- none of
# them start with a dot. Production deploys by `git pull`, so .git is present, and
# it was fully readable: /engcalcs/.git/ served a browsable index, refs/heads/master
# gave the tip SHA, and objects/pack/*.pack downloaded intact (verified 2026-07-28).
# The suite is GPL v3, so published source is not the concern -- the concern is that
# dev/.htaccess deliberately blocks dev/ over HTTP while the packfiles handed out the
# same content anyway, plus the reflog carries committer names and addresses.
# mod_alias, the same override level as the Redirect rules above, so this is known to
# be permitted here -- unlike Options, which needs a separate AllowOverride grant.
RedirectMatch 404 "/\.git(/|$)"

# Turn off directory listings. Without this, /engcalcs/lib/, /js/ and /css/ each
# served a full file index (verified 2026-07-28) -- not a source leak on its own,
# but it hands an attacker the exact filename list to probe.
#
# CAUTION: unlike everything above this line, Options needs `AllowOverride Options`,
# which is a SEPARATE grant from the FileInfo/Limit the rest of this file relies on.
# Where it is not granted Apache returns 500 for every request under /engcalcs/ --
# it fails loud, not silent. Confirmed working on this host 2026-07-28; if the site
# is ever moved, re-test this line first and delete it if the new host 500s.
Options -Indexes
